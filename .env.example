# ── myLifeTracker — required environment variables ────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# ── Supabase (shared with Samsara Community App) ──────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Business / Olive Oil Supabase (separate project) ─────────────────────────
VITE_BUSINESS_SUPABASE_URL=https://your-business-project-ref.supabase.co
VITE_BUSINESS_SUPABASE_KEY=your-service-role-key-here
